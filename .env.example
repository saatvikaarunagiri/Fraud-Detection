# Copy to `.env`. Nothing here is required for the local/free path. Add a key
# only to use a hosted LLM for the agentic investigator.

# ---- Optional hosted LLM for the investigator (blank = local ReAct fallback) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
USE_LOCAL_LLM=true
OLLAMA_URL=http://localhost:11434

# ---- Infra (match docker-compose; override only if you change ports) ----
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379/0
